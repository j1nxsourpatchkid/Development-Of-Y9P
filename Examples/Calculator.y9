@bring /io.standard/

entry main()
{
    mut num a = 0;
    mut num b = 0;
    mut string op = "";

    display.show("First number: ");
    input.read(a);

    display.show("Second number: ");
    input.read(b);

    display.show("Operator (+, -, *, /): ");
    input.read(op);

    if (op == "+")
    {
        display.show(a + b);
    }
    elif (op == "-")
    {
        display.show(a - b);
    }
    elif (op == "*")
    {
        display.show(a * b);
    }
    elif (op == "/")
    {
        if (b == 0)
        {
            display.show("Error: division by zero");
        }
        else
        {
            display.show(a / b);
        }
    }
    else
    {
        display.show("Unknown operator");
    }

    return 0;
}
