@bring /io.standard/

entry main()
{
    num age = 17;
    float speed = 5.5;
    deci distance = 123.456;
    bool alive = true;
    chr letter = 'A';
    string name = "Alex";

    display.show(age);
    display.show(speed);
    display.show(distance);
    display.show(alive);
    display.show(letter);
    display.show(name);

    return 0;
}
