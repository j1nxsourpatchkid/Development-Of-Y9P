entry main()
{
    mut num x = 0;

    while (x < 5) do
    {
        if (x == 2) do
        {
            next;
        }
        display.show(x);
        x += 1;
    }

    display.show("---");

    x = 0;
    while (x < 5) do
    {
        if (x == 3) do
        {
            break;
        }
        display.show(x);
        x += 1;
    }

    display.show("done");
    return 0;
}
