fn celsiusToFahrenheit(float c) -> float {
    return (c * 9.0 / 5.0) + 32.0;
}

fn fahrenheitToCelsius(float f) -> float {
    return (f - 32.0) * 5.0 / 9.0;
}

fn metersToFeet(float m) -> float {
    return m * 3.28084;
}

fn kilometersToMiles(float km) -> float {
    return km * 0.621371;
}

entry main() {
    display.show("=== Y9 Unit Converter ===");

    float tempC = 25.0;
    display.show(tempC + " °C = " + celsiusToFahrenheit(tempC) + " °F");

    float tempF = 98.6;
    display.show(tempF + " °F = " + fahrenheitToCelsius(tempF) + " °C");

    float meters = 10.0;
    display.show(meters + " meters = " + metersToFeet(meters) + " feet");

    float km = 5.0;
    display.show(km + " km = " + kilometersToMiles(km) + " miles");

    return 0;
}