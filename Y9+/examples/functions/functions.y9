fn add(int a, int b) -> int {
    return a + b;
}

fn greetUser(string name) {
    display.show("Welcome to Y9, " + name + "!");
}

fn calculateArea(float width, float height) -> float {
    return width * height;
}

entry main() {
    greetUser("Developer");

    int sum = add(15, 27);
    display.show("15 + 27 = " + sum);

    float area = calculateArea(5.5, 4.0);
    display.show("Area: " + area);

    // Anonymous / Lambda function
    fn multiply = fn(int x, int y) -> int {
        return x * y;
    };
    display.show("5 * 6 = " + multiply(5, 6));

    return 0;
}